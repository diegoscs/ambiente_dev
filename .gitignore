# sem ninguem ter pedido, e traria node_modules junto.
clientes/
projetos/
arquivo/

# Configuracao pessoal do VS Code (commit + sync automatico)
.vscode/

# Minecraft no PC: backups do mundo e a senha do RCON no LEIA-ME.
