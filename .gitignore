# Segredos - o .env.example e o que vai para o repositorio
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Saida dos robos: log de erro, estado local, caches
temp/
logs/
saida/

# Projetos com repositorio proprio - nao entram neste repo.
