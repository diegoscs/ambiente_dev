# =============================================
# Modelo do .env da raiz (D:\ambiente_dev\.env).
# Copie para .env e preencha. O .env NUNCA e commitado.
#
# Variavel de ambiente do Windows tem prioridade sobre o arquivo: da para
# sobrescrever uma execucao pontual sem editar nada aqui.
# =============================================

# ─── GitHub (robo 001) ───────────────────────────────────────────────────────
# Classico com scope "repo", ou fine-grained com "Contents: Read and write".
# No GitHub Actions o mesmo token vai no secret GH_PAT (secret nao pode comecar
# com GITHUB_); o robo le GH_PAT primeiro e cai para GITHUB_TOKEN.
GITHUB_TOKEN=

# ─── Supabase (controle de cargas dos robos + keepalive do 002) ──────────────
# Vai para a coluna "ambiente" do registro: LOCAL = rodou no PC (na mao),
# CLOUD = GitHub Actions. Os workflows definem CLOUD sozinhos.
MODO_EXECUCAO=LOCAL

# Settings > API > Project URL
SUPABASE_URL=https://mthipdxpedlfnkzddlar.supabase.co

# Settings > API > service_role. Precisa ser a service_role: a anon esbarra na
# RLS da tabela de controle. E um segredo de servidor - nunca vai para o browser.
SUPABASE_KEY=

# Settings > Database > Connection string > Transaction pooler (porta 6543).
# postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=

# ─── Telegram (alerta de falha) ──────────────────────────────────────────────
# TOKEN: o @BotFather devolve ao criar o bot.
# CHAT_ID: mande uma mensagem ao bot e leia em
#          https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
